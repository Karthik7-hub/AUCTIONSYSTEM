{
    "compilerOptions": {
        "baseUrl": ".",
        "paths": {
            "@/*": ["src/*"],
            "@components/*": ["src/components/*"],
            "@pages/*": ["src/pages/*"],
            "@layouts/*": ["src/layouts/*"],
            "@services/*": ["src/services/*"],
            "@styles/*": ["src/styles/*"],
            "@config/*": ["src/config/*"],
            "@constants/*": ["src/constants/*"],
            "@hooks/*": ["src/hooks/*"],
            "@utils/*": ["src/utils/*"]
        }
    },
    "include": ["src/**/*"]
}
