# Server Port
PORT=5000

# MongoDB Connection URI
MONGO_URI=mongodb://localhost:27017/auction_system

# Super Admin Password (for system administration)
SUPER_ADMIN_PASSWORD=your_super_admin_password

# ImageKit Configuration (for player and team image uploads)
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=your_imagekit_url_endpoint

# JWT Secret Keys (use long, random, secure strings in production)
JWT_SECRET=your_jwt_secret
JWT_REFRESH_SECRET=your_jwt_refresh_secret

# Configurable Frontend Client URL(s) for CORS.
# Separate multiple URLs with commas if needed (e.g. http://localhost:5173,https://your-app.vercel.app).
# Leave blank or omit to allow all origins (*) in development.
CLIENT_URL=http://localhost:5173
